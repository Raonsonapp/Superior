# =========================
# Superior AI
# =========================

PORT=8080

# =========================
# Hugging Face
# =========================

HF_TOKEN=your_huggingface_token

# =========================
# AI Model
# =========================

AI_MODEL=Qwen/Qwen3-8B

# =========================
# Supabase
# =========================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE=your_service_role_key

# =========================
# PostgreSQL
# =========================

DATABASE_URL=postgres://postgres:password@host:5432/postgres

# =========================
# Cloudflare R2
# =========================

R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com

R2_BUCKET=superior

R2_ACCESS_KEY=xxxxxxxxxxxxxxxx

R2_SECRET_KEY=xxxxxxxxxxxxxxxx

R2_PUBLIC_URL=https://xxxxxxxx.r2.dev

# =========================
# Security
# =========================

JWT_SECRET=Superior_AI_2026

APP_NAME=Superior AI

APP_VERSION=1.0.0
